{
  "name": "Fauna",
  "short_name": "Fauna",
  "description": "Wildlife sighting log",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0e0a",
  "theme_color": "#0a0e0a",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "photos",
          "accept": ["image/*", ".jpg", ".jpeg", ".png", ".heic", ".heif", ".webp"]
        }
      ]
    }
  }
}
